        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% DEFINISI WARNA SESUAI GAMBAR REFERENSI CHEN ERD\n    classDef entity fill:#1b557a,stroke:#0d3b56,stroke-width:2px,color:#ffffff,font-weight:bold\n    classDef weakEntity fill:#1b557a,stroke:#ffffff,stroke-width:3px,color:#ffffff,font-weight:bold\n    classDef rel fill:#8fd3c7,stroke:#5ba89c,stroke-width:2px,color:#1a3a35,font-weight:bold\n    classDef pkAttr fill:#5c335c,stroke:#3d1f3d,stroke-width:2px,color:#ffffff,font-weight:bold\n    classDef regAttr fill:#a63a79,stroke:#7a2657,stroke-width:1.5px,color:#ffffff\n    classDef relAttr fill:#eee8aa,stroke:#9e9756,stroke-width:1.5px,color:#222222\n    classDef derivedAttr fill:#f5f2d0,stroke:#9e9756,stroke-width:1.5px,stroke-dasharray: 5 5,color:#222222\n\n    %% =========================================================\n    %% TINGKAT 1 (ATAS): JURUSAN -&gt; KELAS -&gt; MURID -&gt; SESI LOGIN\n    %% =========================================================\n    PK_JURUSAN([\&quot;&lt;u&gt;id_jurusan&lt;/u&gt;\&quot;]):::pkAttr\n    A_JUR_1([\&quot;kode_jurusan\&quot;]):::regAttr\n    A_JUR_2([\&quot;nama_jurusan\&quot;]):::regAttr\n    E_JURUSAN[\&quot;Jurusan\&quot;]:::entity\n\n    PK_JURUSAN ~~~ A_JUR_1 ~~~ A_JUR_2\n    PK_JURUSAN --- E_JURUSAN\n    A_JUR_1 --- E_JURUSAN\n    A_JUR_2 --- E_JURUSAN\n\n    R_JUR_KLS{\&quot;Memiliki\&quot;}:::rel\n    E_JURUSAN ---|\&quot;1\&quot;| R_JUR_KLS\n\n    PK_KELAS([\&quot;&lt;u&gt;id_kelas&lt;/u&gt;\&quot;]):::pkAttr\n    A_KLS_1([\&quot;tingkat\&quot;]):::regAttr\n    A_KLS_2([\&quot;kode_rombel\&quot;]):::regAttr\n    A_KLS_3([\&quot;nama_kelas\&quot;]):::regAttr\n    E_KELAS[\&quot;Kelas\&quot;]:::entity\n\n    PK_KELAS ~~~ A_KLS_1 ~~~ A_KLS_2 ~~~ A_KLS_3\n    R_JUR_KLS ===|\&quot;N\&quot;| E_KELAS\n    PK_KELAS --- E_KELAS\n    A_KLS_1 --- E_KELAS\n    A_KLS_2 --- E_KELAS\n    A_KLS_3 --- E_KELAS\n\n    R_KLS_MRD{\&quot;Menempati\&quot;}:::rel\n    E_KELAS ---|\&quot;1\&quot