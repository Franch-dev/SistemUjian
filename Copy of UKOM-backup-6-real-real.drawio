pel\&quot;]):::regAttr\n    A_MPL_2([\&quot;nama_mapel\&quot;]):::regAttr\n    A_MPL_3([\&quot;nilai_kkm\&quot;]):::regAttr\n    E_MAPEL[\&quot;Mapel\&quot;]:::entity\n\n    E_KELAS ~~~ PK_MAPEL\n    PK_MAPEL ~~~ A_MPL_1 ~~~ A_MPL_2 ~~~ A_MPL_3\n    PK_MAPEL --- E_MAPEL\n    A_MPL_1 --- E_MAPEL\n    A_MPL_2 --- E_MAPEL\n    A_MPL_3 --- E_MAPEL\n\n    R_GR_PLT{\&quot;Mengampu\&quot;}:::rel\n    R_MPL_PLT{\&quot;Memetakan\&quot;}:::rel\n    R_KLS_PLT{\&quot;Menerima_Mapel\&quot;}:::rel\n\n    PK_PLOTTING([\&quot;&lt;u&gt;id_plotting&lt;/u&gt;\&quot;]):::pkAttr\n    A_PLT_1([\&quot;created_at\&quot;]):::relAttr\n    E_PLOTTING[[\&quot;Plotting_Mapel\&quot;]]:::weakEntity\n\n    PK_PLOTTING ~~~ A_PLT_1\n    E_GURU ---|\&quot;1\&quot;| R_GR_PLT ---|\&quot;N\&quot;| E_PLOTTING\n    E_MAPEL ---|\&quot;1\&quot;| R_MPL_PLT ===|\&quot;N\&quot;| E_PLOTTING\n    E_KELAS ---|\&quot;1\&quot;| R_KLS_PLT ===|\&quot;N\&quot;| E_PLOTTING\n    PK_PLOTTING --- E_PLOTTING\n    A_PLT_1 --- E_PLOTTING\n\n    %% =========================================================\n    %% TINGKAT 3 (TENGAH): BANK_SOAL, ADMIN, PROFIL &amp; SESI_UJIAN\n    %% =========================================================\n    R_PLT_SOAL{\&quot;Memiliki_Soal\&quot;}:::rel\n    E_PLOTTING ---|\&quot;1\&quot;| R_PLT_SOAL\n\n    PK_SOAL([\&quot;&lt;u&gt;id_soal&lt;/u&gt;\&quot;]):::pkAttr\n    A_SL_PERT([\&quot;pertanyaan\&quot;]):::regAttr\n    A_SL_GBR([\&quot;path_gambar\&quot;]):::regAttr\n    A_SL_OPSI([\&quot;opsi_a_sampai_e\&quot;]):::regAttr\n    A_SL_KUNCI([\&quot;kunci_jawaban\&quot;]):::regAttr\n    A_SL_BOBOT([\&quot;bobot_soal\&quot;]):::regAttr\n    E_SOAL[[\&quot;Bank_Soal\&quot;]]:::weakEntity\n\n    PK_SOAL ~~~ A_SL_PERT ~~~ A_SL_GBR\n    A_SL_OPSI ~~~ A_SL_KUNCI ~~~ A_SL_BOBOT\n    R_PLT_SOAL ===|\&quot;N\&quot;| E_SOAL\n    PK_SOAL --- E_SOAL\n    A_SL_PERT --- E_SOAL\n    A_SL_GBR --- E_SOAL\n    A_SL_OPSI --- E_SOAL\n    A_SL_KUNCI --- E_SOAL\n    A_SL_BOBOT --- E_SOAL\n\n    PK_ADMIN([\&quo